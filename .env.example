# BYOK 真模型。未配置可用 Key 时：Demo/默认走 mock 离线脚本（可全流程跑通）。
# 配置 DEEPSEEK_API_KEY / OPENAI_API_KEY 后：Home Demo 自动改走真模型，不再注入 mockScenario。
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# 本机 Ollama：Models 面板始终可选；自动选用 Plan/Composer 默认需显式打开
# LOOM_USE_OLLAMA=1
# OLLAMA_API_KEY=ollama

# 联网 / 本地命令（可选）
# TAVILY_API_KEY=          # 或 LOOM_SEARCH_API_KEY / SERPAPI_API_KEY —— 配置后 web_search 可用
# LOOM_FETCH_TIMEOUT_MS=8000
# LOOM_FETCH_MAX_CHARS=4000
# LOOM_SAFE_CMDS=          # 逗号分隔额外白名单前缀，默认含 git status/diff/log
# LOOM_CMD_TIMEOUT_MS=15000
